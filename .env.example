# Doma Testnet
DOMA_RPC_URL=https://rpc-testnet.doma.xyz
PRIVATE_KEY=0xyour_deployer_private_key_here

# Grab this from https://docs.doma.xyz/api-reference/doma-network-information
# -> "Deployed Smart Contracts" -> Ownership Token address for the chain you're deploying to.
DOMA_OWNERSHIP_TOKEN=0x0000000000000000000000000000000000000000

# Leave as 0x0 to have the script deploy a MockUSDCe test token instead of
# using a real bridged USDC.e address (fine for early testnet experimentation).
USDC_ADDRESS=0x0000000000000000000000000000000000000000
